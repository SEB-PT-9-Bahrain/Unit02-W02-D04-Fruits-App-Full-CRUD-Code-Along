<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Update Fruit</h1>

    <form>
        <label for="name">Name:</label>
        <input value="<%= fruit.name%>" id="name" name="name" type="text">

        <label for="isReadyToEat">Is Ready to Eat?</label>
        <input <% if(fruit.isReadyToEat){ %> checked <% } %> id="isReadyToEat" name="isReadyToEat" type="checkbox">
        <button>Update Fruit</button>  
    </form>
</body>
</html>